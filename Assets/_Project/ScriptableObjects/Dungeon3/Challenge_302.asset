  challenge:
    challengeId: 302
    dungeonId: 3
    topic: Logical reasoning
    questionType: 0
    promptText: 'Four of these seals are square numbers: 4, 9, 16, 20, 25. Which
      one is not?'
    options:
    - 9
    - 16
    - 20
    - 25
    correctAnswer: 20
    hintText: A square number is a whole number multiplied by itself.
    explanationText: "4 = 2\xB2, 9 = 3\xB2, 16 = 4\xB2 and 25 = 5\xB2. 20 is not
      a square number."
